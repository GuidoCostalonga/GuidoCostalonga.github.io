# Copiare questo file in .env (che NON va mai pubblicato né caricato su GitHub)
# e compilare i valori. Ogni connettore si attiva solo se ha le sue credenziali.

# ---------------------------------------------------------------- analisi (obbligatorio)
ANTHROPIC_API_KEY=
MODELLO_ANALISI=claude-opus-5-5
# low = più economico e rapido, medium = equilibrato, high = più accurato su testi ambigui
SFORZO_ANALISI=medium
DIMENSIONE_LOTTO=10

# ---------------------------------------------------------------- accesso al cruscotto
# Uno o più codici separati da virgola, almeno 20 caratteri casuali ciascuno
CODICI_ACCESSO=
# Stringa casuale lunga: python3 -c "import secrets; print(secrets.token_hex(32))"
SEGRETO_SESSIONE=
# Indirizzi da cui viene servito il cruscotto (separati da virgola)
ORIGINI_AMMESSE=https://atlantefvg.it,https://www.atlantefvg.it
# Firma delle richieste in ingresso su /api/ingresso
SEGRETO_WEBHOOK=

# ---------------------------------------------------------------- soglie delle allerte
FINESTRA_MINUTI=15
BASE_ORE=6
VOLUME_MINIMO=12
CALO_CRISI=30
QUOTA_NEGATIVA_CRISI=0.6
CRESCITA_OPPORTUNITA=2.0
INDICE_OPPORTUNITA=40
PAUSA_ALLERTA_MINUTI=45

# ---------------------------------------------------------------- notifiche allo staff
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_STAFF=
WEBHOOK_NOTIFICHE=

# ---------------------------------------------------------------- connettori
INTERVALLO_RSS_SECONDI=300
INTERVALLO_SOCIAL_SECONDI=120
BLUESKY_UTENTE=
BLUESKY_PASSWORD_APP=
X_BEARER_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
# Versione della Graph API da verificare sulla documentazione Meta, es. v21.0
META_VERSIONE_GRAPH=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------- archivio
GIORNI_CONSERVAZIONE=30
MODALITA_SVILUPPO=false
