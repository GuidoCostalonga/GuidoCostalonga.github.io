<?xml version="1.0" encoding="utf-8"?>
<!-- Widget piccolo: icona animata, temperatura e Comune, uno sotto l'altro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <include
        layout="@layout/widget_animazione"
        android:layout_width="50dp"
        android:layout_height="50dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/temperatura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_extrabold"
            android:includeFontPadding="false"
            android:text="@string/widget_temperatura_vuota"
            android:textColor="@color/testo"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:text="@string/grado"
            android:textColor="@color/giallo_scuro"
            android:textSize="21sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/comune"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_extrabold"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_nome"
        android:textColor="@color/blu"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/estremi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_medium"
        android:gravity="center"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/testo_3"
        android:textSize="11sp" />

    <!--
        Nel formato piccolo lo spazio non basta per il testo della condizione
        e per l'ora: le viste restano, nascoste, cosi il codice che scrive nel
        widget e' uno solo per tutti i formati.
    -->
    <TextView
        android:id="@+id/condizione"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:visibility="gone" />

    <TextView
        android:id="@+id/aggiornato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ricarica"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/widget_ricarica"
        android:src="@drawable/ic_ricarica"
        android:visibility="gone" />
</LinearLayout>
