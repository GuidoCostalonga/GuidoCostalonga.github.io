<?xml version="1.0" encoding="utf-8"?>
<!-- Widget largo: icona animata, temperatura, condizione, minime e massime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/radice"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <include
        layout="@layout/widget_animazione"
        android:layout_width="66dp"
        android:layout_height="66dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/comune"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_extrabold"
            android:maxLines="1"
            android:text="@string/app_nome"
            android:textAllCaps="false"
            android:textColor="@color/blu"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temperatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:includeFontPadding="false"
                android:text="@string/widget_temperatura_vuota"
                android:textColor="@color/testo"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:text="@string/grado"
                android:textColor="@color/giallo_scuro"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/condizione"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_semibold"
                android:maxLines="2"
                android:text=""
                android:textColor="@color/testo_2"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/estremi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:text="@string/widget_in_attesa"
            android:textColor="@color/testo_3"
            android:textSize="12sp" />
    </LinearLayout>

    <!--
        La freccia e l'ora restano due viste distinte, non un testo con
        disegno a fianco: solo la freccia deve rispondere al tocco.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/ricarica"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_ricarica"
            android:padding="6dp"
            android:src="@drawable/ic_ricarica" />

        <TextView
            android:id="@+id/aggiornato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/testo_3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
