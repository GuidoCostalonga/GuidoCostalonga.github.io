<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PCCheck.Core</RootNamespace>
    <AssemblyName>PCCheck</AssemblyName>
    <Product>PC Check</Product>
    <Version>1.0.0</Version>
    <Authors>PC Check</Authors>
    <Description>Diagnostica locale di sicurezza e prestazioni per Windows 10 e 11.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <!-- Nessuna telemetria, nessun servizio esterno: l'app e' solo locale. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Impostazioni usate da dotnet publish (vedi scripts/build-portable.ps1). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <!-- L'interfaccia web viene incorporata nell'eseguibile: il pacchetto portatile e' un solo file. -->
    <EmbeddedResource Include="wwwroot\**" />
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
