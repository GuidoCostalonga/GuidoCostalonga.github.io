<?xml version="1.0" encoding="utf-8"?>
<!-- Dati sanitari: nessun backup automatico nel cloud di Google né trasferimento
     automatico. Si usa solo il backup cifrato con passphrase scelto dall'utente. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
